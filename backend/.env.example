# OpenF1 Query API base URL (default: public hosted API, no auth for historical data)
OPENF1_BASE_URL=https://api.openf1.org/v1

# Local self-hosted OpenF1 (run on 8001 so this app can use 8000):
#   uvicorn openf1.services.query_api.app:app --reload --port 8001
# OPENF1_BASE_URL=http://127.0.0.1:8001/v1

# Disk cache for replay JSON
# F1_CACHE_DIR=f1_cache
